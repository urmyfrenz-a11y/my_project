# 실제 값은 .env.local 에 넣으세요 (git 에 커밋되지 않습니다).

# 카카오 장소/리뷰 (필수 — 카카오 REST API 키)
KAKAO_REST_API_KEY=

# 카카오 리뷰는 패널 API(별점+블로그, ~7개)만 사용합니다. (브라우저 워커는
# 실익이 적어 폐기 — 카카오의 많은 리뷰는 대부분 네이버 검색과 중복되는 블로그 링크)

# 인터넷 검색 소스 — 네이버 검색 오픈API (무료, 하루 25,000건, 초과해도 과금 없음).
# https://developers.naver.com/apps 에서 앱 등록 후 '검색' API 추가하고 키를 넣으세요.
# (없으면 "준비중"으로 표시. Bing/DuckDuckGo는 Vercel 데이터센터 IP가 차단돼 동작 안 함)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 네이버 플레이스 방문자 리뷰 — 스크래핑 API(한국 IP + JS 렌더링)로 서버에서 수집.
# Scrapingdog 무료 티어(월 1,000 크레딧, 카드 등록 없음). https://www.scrapingdog.com/dashboard
# 없으면 네이버 플레이스는 브라우저 확장 안내 카드로 대체됩니다.
SCRAPINGDOG_API_KEY=

# 네이버 (선택) — 별도 Playwright 워커(/naver-worker)를 한국 IP에서 실행 후 연결
NAVER_WORKER_URL=
NAVER_WORKER_TOKEN=
